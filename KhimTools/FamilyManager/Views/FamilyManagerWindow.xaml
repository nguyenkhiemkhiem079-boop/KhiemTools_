<Window x:Class="KhimTools.FamilyManager.Views.FamilyManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:KhimTools.FamilyManager.Models"
        mc:Ignorable="d"
        Title="KhimTools — Family Manager" 
        Height="650" Width="880"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True">

    <Window.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0"/>
            <GradientStop Color="#1E293B" Offset="0.6"/>
            <GradientStop Color="#334155" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="#94A3B8" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="270" ShadowDepth="8" Opacity="0.3" Color="#0F172A"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Search & Filter Bar -->
                <RowDefinition Height="*"/>    <!-- Main Content Area -->
                <RowDefinition Height="Auto"/> <!-- Bottom Status & Actions -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" CornerRadius="12,12,0,0" Padding="20,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#2563EB" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="K-TOOLS" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            </Border>
                            <TextBlock Text="FAMILY MANAGER &amp; QUICK DRAFT" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Load only what you need. Rebar loads complete library." FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="BtnClose_Click" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Cursor="Hand" Width="32" Height="32" FontSize="16" FontWeight="Bold">
                            ✕
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Search & Controls Bar -->
            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#94A3B8"/>
                            <TextBox Grid.Column="1" x:Name="TxtSearch" BorderThickness="0" Background="Transparent" FontSize="13" VerticalAlignment="Center" TextChanged="TxtSearch_TextChanged" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Options -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkOverwriteExisting" Content="Overwrite parameter values on reload" VerticalAlignment="Center" FontSize="12" Foreground="#475569" Margin="0,0,16,0" ToolTip="Non-destructive by default. If checked, updates parameter definitions from file."/>
                        <Button Style="{StaticResource ModernButton}" Content="🔄 Rescan Folders" Click="BtnRescan_Click" Padding="10,6" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area: Master-Detail Layout -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Group Sidebar -->
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="LOGICAL GROUPS" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="16,14,16,8"/>
                        <ListBox x:Name="ListGroups" BorderThickness="0" Background="Transparent" SelectionChanged="ListGroups_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" CornerRadius="6" Margin="4,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                                                <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <!-- Parent checkbox directly in group item -->
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="{Binding IsSelective}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="{Binding RuleDescription}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Right Family Items Detail View -->
                <Grid Grid.Column="1" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Group Banner & Selective/Bi-state rule explanation -->
                        <RowDefinition Height="*"/>    <!-- Families DataGrid / List -->
                    </Grid.RowDefinitions>

                    <!-- Group Banner -->
                    <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtSelectedGroupName" Text="Structure Families" FontWeight="Bold" FontSize="15" Foreground="#1E40AF"/>
                                <TextBlock x:Name="TxtSelectedGroupRule" Text="Selective loading: check only what you need." FontSize="12" Foreground="#3B82F6" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Group Action Button (e.g. Select All / Deselect All for selective) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnSelectAllInGroup" Style="{StaticResource ModernButton}" Content="Select All" Click="BtnSelectAllInGroup_Click" FontSize="11" Margin="0,0,6,0"/>
                                <Button x:Name="BtnClearAllInGroup" Style="{StaticResource ModernButton}" Content="Deselect All" Click="BtnClearAllInGroup_Click" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Families List -->
                    <DataGrid Grid.Row="1" x:Name="GridFamilies" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" BorderThickness="1" BorderBrush="#E2E8F0" Background="White" RowHeight="36">
                        <DataGrid.Columns>
                            <!-- Checkbox Column -->
                            <DataGridTemplateColumn Width="40" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Family Name -->
                            <DataGridTemplateColumn Width="*" Header="Family Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FamilyName}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Width="160" Header="Project Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock Text="{Binding StatusBadge}" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Loaded Types -->
                            <DataGridTextColumn Width="80" Header="Types" Binding="{Binding LoadedTypeCount}"/>

                            <!-- File Size -->
                            <DataGridTextColumn Width="90" Header="Size" Binding="{Binding FileSizeText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <!-- Bottom Status & Actions -->
            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14" CornerRadius="0,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Summary & Progress -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtOverallSummary" Text="Ready to load." FontSize="13" Foreground="#475569" FontWeight="Medium"/>
                        <ProgressBar x:Name="ProgressBarLoad" Height="6" Minimum="0" Maximum="100" Margin="0,6,24,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource ModernButton}" Content="Cancel" Click="BtnClose_Click" Margin="0,0,10,0"/>
                        <Button x:Name="BtnLoadSelected" Style="{StaticResource PrimaryButton}" Content="Load Selected Families" Click="BtnLoadSelected_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
