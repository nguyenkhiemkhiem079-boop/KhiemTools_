<Window x:Class="KhimTools.DoorSchedule.UI.ScheduleOptionsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="K-TOOL — Thống kê cửa đi / cửa sổ · Revit 2025" Width="1140" Height="860"
 MinWidth="940" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#F7F8FA"
 FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="30"/></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="8"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="THỐNG KÊ CỬA ĐI / CỬA SỔ" FontSize="22" FontWeight="SemiBold" Foreground="#123B55"/>
   <TextBlock Text="Chỉ model hiện tại · Schedule/Quantities native · Kích thước mm · Count tự cập nhật" Margin="0,5,0,12"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <StackPanel><WrapPanel><CheckBox x:Name="DoorsCheck" Content="Cửa đi — Doors" IsChecked="True"/><CheckBox x:Name="WindowsCheck" Content="Cửa sổ — Windows" IsChecked="True"/></WrapPanel>
    <TextBlock Text="Phạm vi tầng"/><ComboBox x:Name="LevelCombo" DisplayMemberPath="Name"/>
    <TextBlock Text="Cách gom dòng"/><ComboBox x:Name="GroupingCombo" DisplayMemberPath="Name"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="Phase của bảng" Margin="4,8,0,0"/><ComboBox x:Name="PhaseCombo" DisplayMemberPath="Name"/>
    <TextBlock Text="Phase Filter — chọn đối tượng thực trong project"/><ComboBox x:Name="PhaseFilterCombo" DisplayMemberPath="Name"/>
    <CheckBox x:Name="SeparateCopyCheck" Content="Tạo bản riêng khi bảng cũ có chỉnh sửa xung đột"/>
   </StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="Tiền tố tên bảng" Margin="4,8,0,0"/><TextBox x:Name="PrefixText" Text="K-TOOL"/>
    <CheckBox x:Name="PlaceCheck" Content="Đặt lên sheet có sẵn"/><ComboBox x:Name="SheetCombo" DisplayMemberPath="Name" IsEnabled="False"/>
    <WrapPanel><TextBlock Text="X (mm)" VerticalAlignment="Center"/><TextBox x:Name="XText" Text="20" Width="65"/><TextBlock Text="Y (mm)" VerticalAlignment="Center"/><TextBox x:Name="YText" Text="250" Width="65"/></WrapPanel>
    <TextBlock Text="Gốc tọa độ sheet (Revit); X sang phải, Y lên trên." FontSize="11" TextWrapping="Wrap"/>
   </StackPanel>
  </Grid>
  <TabControl Grid.Row="2" Margin="0,12,0,6">
   <TabItem Header="Ánh xạ parameter"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MappingHost" Margin="12"/></ScrollViewer></TabItem>
   <TabItem x:Name="PreviewTab" Header="Xem trước"><Grid><DataGrid x:Name="PreviewGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" EnableRowVirtualization="True"/><TextBlock x:Name="EmptyPreviewHint" Text="Chọn Phase / Phase Filter, kiểm tra ánh xạ rồi bấm Làm mới xem trước." TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="700" Margin="28" IsHitTestVisible="False" Foreground="#123B55"/></Grid></TabItem>
   <TabItem x:Name="DiagnosticTab" Header="Cảnh báo / Nguồn dữ liệu"><DataGrid x:Name="DiagnosticGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
    <DataGrid.Columns><DataGridTextColumn Header="Mức" Binding="{Binding Severity}" Width="85"/><DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="180"/><DataGridTextColumn Header="ElementId" Binding="{Binding ElementId}" Width="100"/><DataGridTextColumn Header="Chi tiết" Binding="{Binding Message}" Width="*"/></DataGrid.Columns>
   </DataGrid></TabItem>
  </TabControl>
  <ScrollViewer Grid.Row="3" MaxHeight="130" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="StatusText" Text="Chọn ánh xạ, Phase và Phase Filter rồi làm mới xem trước." TextWrapping="Wrap" Margin="4,6" Foreground="#123B55"/></ScrollViewer>
  <DockPanel Grid.Row="4"><Button x:Name="CancelButton" Content="Hủy / Đóng" DockPanel.Dock="Right" IsCancel="True"/><Button x:Name="OpenButton" Content="Mở bảng" DockPanel.Dock="Right" IsEnabled="False"/>
   <Button x:Name="CreateButton" Content="Tạo / Cập nhật" DockPanel.Dock="Right" IsEnabled="False" Background="#123B55" Foreground="White"/>
   <Button x:Name="ExportButton" Content="Xuất CSV" DockPanel.Dock="Right" IsEnabled="False"/><Button x:Name="CopyDiagnosticButton" Content="Copy chẩn đoán" DockPanel.Dock="Right" IsEnabled="False"/><Button x:Name="PreviewButton" Content="Làm mới xem trước" HorizontalAlignment="Left"/>
  </DockPanel>
 </Grid>
</Window>
