<Window x:Class="KhimTools.Structural.QuickStructure.Forms.QuickStructureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="K-TOOLS — Quick Structure Generator"
        Height="500" Width="680"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>


        <Style x:Key="SectionCard" TargetType="GroupBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ContentPresenter Grid.Row="1" ContentSource="Content"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#1677D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1262B0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 2. CONTENT SECTIONS -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <!-- SECTION A: CỘT KẾT CẤU -->
                <GroupBox Header="Cột" Style="{StaticResource SectionCard}">
                    <Grid Margin="0,6,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="ChkCreateColumns" Grid.Row="0" Grid.Column="0" Content="Tạo cột" IsChecked="True" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CboColumnType" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Base Level (Tầng đáy):" VerticalAlignment="Center" FontWeight="Normal"/>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="84"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CboColumnBaseLevel" Grid.Column="0" Height="28" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Offset (mm):" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" FontWeight="Normal"/>
                            <TextBox x:Name="TxtColumnBaseOffset" Grid.Column="2" Text="0" Height="28" VerticalContentAlignment="Center"/>
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Top Level (Tầng đỉnh):" VerticalAlignment="Center" FontWeight="Normal"/>
                        <Grid Grid.Row="2" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="84"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CboColumnTopLevel" Grid.Column="0" Height="28" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Offset (mm):" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" FontWeight="Normal"/>
                            <TextBox x:Name="TxtColumnTopOffset" Grid.Column="2" Text="0" Height="28" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- SECTION B: DẦM KẾT CẤU -->
                <GroupBox Header="Dầm" Style="{StaticResource SectionCard}">
                    <Grid Margin="0,6,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="ChkCreateBeams" Grid.Row="0" Grid.Column="0" Content="Tạo dầm" IsChecked="True" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CboBeamType" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Cao độ tầng đặt dầm:" VerticalAlignment="Center" FontWeight="Normal"/>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="84"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CboBeamLevel" Grid.Column="0" Height="28" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Offset (mm):" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" FontWeight="Normal"/>
                            <TextBox x:Name="TxtBeamZOffset" Grid.Column="2" Text="0" Height="28" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- SECTION C: MÓNG ĐƠN KẾT CẤU -->
                <GroupBox Header="Móng đơn" Style="{StaticResource SectionCard}">
                    <Grid Margin="0,6,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="ChkCreateFootings" Grid.Row="0" Grid.Column="0" Content="Tạo móng" IsChecked="False" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CboFootingType" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Cao độ tầng đặt móng:" VerticalAlignment="Center" FontWeight="Normal"/>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="84"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CboFootingLevel" Grid.Column="0" Height="28" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Offset (mm):" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" FontWeight="Normal"/>
                            <TextBox x:Name="TxtFootingOffset" Grid.Column="2" Text="0" Height="28" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. FOOTER -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" Text="Sẵn sàng tạo mô hình kết cấu..." Foreground="#64748B" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnGenerate" Content="Tạo Kết Cấu" Tag="Primary" Style="{StaticResource ModernButton}" Margin="0,0,8,0" Click="BtnGenerate_Click"/>
                    <Button x:Name="BtnClose" Content="Đóng" Style="{StaticResource SecondaryButton}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
