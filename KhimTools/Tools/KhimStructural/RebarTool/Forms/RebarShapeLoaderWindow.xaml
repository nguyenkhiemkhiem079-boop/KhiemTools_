<Window x:Class="KhimTools.RebarTool.Forms.RebarShapeLoaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KhimTools.Core.UI"
        Title="K-TOOLS — Rebar Shape Library Manager"
        Height="620" Width="850" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" Foreground="#20262E"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#20262E"/>
            <Setter Property="BorderBrush" Value="#D8DEE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF3FD"/>
                    <Setter Property="BorderBrush" Value="#1677D2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1677D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1677D2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1262B0"/>
                    <Setter Property="BorderBrush" Value="#1262B0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#20262E"/>
            <Setter Property="BorderBrush" Value="#D8DEE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Toolbar / Filter -->
            <RowDefinition Height="*"/>    <!-- DataGrid / List -->
            <RowDefinition Height="Auto"/> <!-- Progress / Status -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- TOOLBAR & SEARCH -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtSearch" Grid.Column="0" Margin="0,0,10,0" TextChanged="TxtSearch_TextChanged"
                     ToolTip="Tìm kiếm theo mã shape (JP_T00, 51, 80...) hoặc mô tả"/>

            <Button x:Name="BtnRefresh" Grid.Column="1" Width="32" Height="32" Padding="6" Click="BtnRefresh_Click" Margin="0,0,10,0" ToolTip="Làm mới" AutomationProperties.Name="Làm mới">
                <Image Width="16" Height="16" Source="{ui:UiIcon icon_update_16.png}"/>
            </Button>
            <Button x:Name="BtnSelectAll" Grid.Column="2" Content="Chọn tất cả" Click="BtnSelectAll_Click"/>
        </Grid>

        <!-- SHAPES LIST -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D8DEE6" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="DgShapes" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" IsReadOnly="False" SelectionMode="Extended"
                      Background="White" RowBackground="White" AlternatingRowBackground="#F8FAFC"
                      Foreground="#20262E" BorderThickness="0" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E3E8EE" HeadersVisibility="Column"
                      ScrollViewer.CanContentScroll="True">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#EEF2F5"/>
                        <Setter Property="Foreground" Value="#465465"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderBrush" Value="#D8DEE6"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- Checkbox selection -->
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="45" MinWidth="45">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>

                    <!-- Shape Name -->
                    <DataGridTextColumn Header="Mã Shape" Binding="{Binding Name}" Width="95" MinWidth="95" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#1677D2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Description -->
                    <DataGridTextColumn Header="Loại / Mô Tả Hình Dạng" Binding="{Binding Description}" Width="250" MinWidth="250" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Trạng Thái Trong Revit" Width="170" MinWidth="170" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{Binding StatusBgColor}">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFgColor}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- File Path -->
                    <DataGridTextColumn Header="Đường Dẫn File .RFA" Binding="{Binding FilePath}" Width="*" MinWidth="160" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#667585"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- PROGRESS & STATUS BAR -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <ProgressBar x:Name="PrgProgress" Height="4" Background="#DCEEF2" Foreground="#1677D2" BorderThickness="0" Margin="0,0,0,4" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtStatus" Text="Sẵn sàng." Foreground="#5E6B7A" FontSize="11" TextWrapping="Wrap" Margin="0,0,10,0"/>
            </StackPanel>
            <TextBlock x:Name="TxtCountSummary" Grid.Column="1" Text="Đã nạp: 0 | Chưa nạp: 43" Foreground="#465465" FontSize="11" VerticalAlignment="Center"/>
        </Grid>

        <!-- FOOTER ACTIONS -->
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="0,10,0,0" BorderBrush="#D8DEE6" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnPreloadCommon" Grid.Column="0" Content="Nạp 10 Shape Cơ Bản" Click="BtnPreloadCommon_Click"
                        ToolTip="Nạp nhanh các shape phổ biến nhất: JP_T00, JP_T02, JP_T11, JP_T21, JP_T51, JP_T75, JP_T80..."/>

                <Button x:Name="BtnLoadSelected" Grid.Column="2" Content="Nạp Các Shape Đã Chọn" Click="BtnLoadSelected_Click" Margin="0,0,10,0"/>

                <Button x:Name="BtnLoadAll" Grid.Column="3" Content="Nạp Tất Cả 43 Shapes" Tag="Primary" Style="{StaticResource PrimaryButton}" Click="BtnLoadAll_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
