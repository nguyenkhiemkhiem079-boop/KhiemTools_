<Window x:Class="KhimTools.OverrideTool.Forms.GraphicOverdriveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KhimTools.Core.UI"
        Title="Graphic Overdrive" Width="248" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="Manual" Left="100" Top="100"
        Background="#F5F7FA" FontFamily="Segoe UI" FontSize="12" Topmost="True" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="ColorChipStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#667482"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#20262E"/>
                                <Setter TargetName="Chip" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#20262E"/>
                                <Setter TargetName="Chip" Property="BorderThickness" Value="3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chip" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chip" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#526170"/><Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4,0,4"/></Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <ItemsControl x:Name="ColorPalette" ItemsSource="{Binding Presets}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="4" Columns="4" Width="168" Height="168"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource ColorChipStyle}" Background="{Binding HexColor}"
                            AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Name}"
                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
            <CheckBox Content="Halftone" IsChecked="{Binding Halftone}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Width="30" Height="30" Padding="5" Command="{Binding ResetOverrideCommand}"
                    ToolTip="Xóa override của đối tượng đang chọn" AutomationProperties.Name="Reset override">
                <Image Width="16" Height="16" Source="{ui:UiIcon override_reset_16.png}"/>
            </Button>
        </Grid>
        <Expander Header="Tùy chọn" IsExpanded="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="340">
                <StackPanel Margin="0,4,8,4">
                    <TextBlock Text="Áp dụng vào" Style="{StaticResource FieldLabel}"/>
                    <UniformGrid Columns="2">
                        <CheckBox Content="Bề mặt" IsChecked="{Binding OverrideSurface}"/>
                        <CheckBox Content="Mặt cắt" IsChecked="{Binding OverrideCut}"/>
                        <CheckBox Content="Đường nét" IsChecked="{Binding OverrideLines}"/>
                        <CheckBox Content="Nền" IsChecked="{Binding OverrideBackground}"/>
                    </UniformGrid>
                    <TextBlock Text="Màu tùy chỉnh" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="btnPickColor" Width="30" Height="30" Padding="4" Background="Red"
                                Click="BtnPickColor_Click" ToolTip="Chọn màu" AutomationProperties.Name="Chọn màu">
                            <Image Width="16" Height="16" Source="{ui:UiIcon override_custom_16.png}"/>
                        </Button>
                        <TextBlock x:Name="txbCustomHex" Grid.Column="1" Text="#FF0000" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Button Content="Áp dụng màu" Tag="Primary" Command="{Binding ApplyCustomColorCommand}" Margin="0,8,0,0"/>
                    <TextBlock Text="Độ trong suốt (%)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Transparency}" VerticalAlignment="Center" ToolTip="Độ trong suốt"/>
                        <TextBlock Grid.Column="1" Text="{Binding Transparency}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Độ đậm nét" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding LineWeightOptions}" SelectedItem="{Binding LineWeight}" ToolTip="Độ đậm nét">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding}"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding}" Value="-1"><Setter Property="Text" Value="Mặc định"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>
        </Expander>
        <TextBlock Text="{Binding StatusText}" Foreground="#526170" FontSize="11"
                   TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</Window>
