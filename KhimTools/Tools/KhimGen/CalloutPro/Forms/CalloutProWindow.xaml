<Window x:Class="KhimTools.CalloutPro.Forms.CalloutProWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Callout Pro"
        Height="420" Width="420"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Roboto"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="4" Background="#FFFFFF" BorderBrush="#E0F2FE" BorderThickness="1.5">


        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Callout Name Pattern -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Đặt Tên Callout" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtNamePattern" Text="Detail - {ParentViewName} - 01" Height="28" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Padding="4,0,0,0"/>
                </StackPanel>

                <!-- View Template Select -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="View Template Áp dụng" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ComboTemplates" Height="28" BorderBrush="#CBD5E1"/>
                </StackPanel>

                <!-- Sheet Destination Selection -->
                <StackPanel Grid.Row="2" Margin="0,0,0,4">
                    <TextBlock Text="Vị trí đặt View (Sheet)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="RadioExistingSheet" Content="Sheet hiện có" IsChecked="True"
                                     Checked="Radio_SheetModeChanged" GroupName="SheetMode"
                                     FontWeight="SemiBold" Margin="0,0,32,0"/>
                        <RadioButton x:Name="RadioNewSheet" Content="Tạo Sheet mới"
                                     Checked="Radio_SheetModeChanged" GroupName="SheetMode"
                                     FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Sheet Options Panel -->
                <Grid Grid.Row="3">
                    <!-- Option A: Existing Sheets -->
                    <Grid x:Name="PanelExistingSheet" Visibility="Visible">
                        <StackPanel>
                            <TextBlock Text="Chọn Sheet" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <ComboBox x:Name="ComboSheets" Height="28" BorderBrush="#CBD5E1"/>
                        </StackPanel>
                    </Grid>

                    <!-- Option B: New Sheet Creator -->
                    <Grid x:Name="PanelNewSheet" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Số hiệu Sheet" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtNewSheetNumber" Text="A-102" Height="28" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Padding="4,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tên bản vẽ (Sheet Name)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtNewSheetName" Text="BẢN VẼ CHI TIẾT" Height="28" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Padding="4,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Khung tên (TitleBlock)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <ComboBox x:Name="ComboTitleBlocks" Height="28" BorderBrush="#CBD5E1"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Bottom Actions -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="4" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid>
                    <Button x:Name="BtnCreate" Content="VẼ CALLOUT &amp; ĐƯA VÀO SHEET"
                            Click="BtnCreate_Click"
                            Width="250" Height="36"
                            Background="#1677D2" BorderBrush="#1677D2"
                            Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1262B0"/>
                                        <Setter Property="BorderBrush" Value="#1262B0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
