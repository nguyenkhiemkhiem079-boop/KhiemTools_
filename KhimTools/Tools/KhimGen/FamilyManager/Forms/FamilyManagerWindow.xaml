<Window x:Class="KhimTools.FamilyManager.Forms.FamilyManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="K-TOOLS — Family Manager" 
        Height="560" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0"/>
            <GradientStop Color="#1E293B" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CBD5E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Border Grid.Row="0" Visibility="Collapsed" Background="{StaticResource HeaderGradient}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="K-TOOLS FAMILY MANAGER" Foreground="White" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="Quản lý, nạp và đồng bộ thư viện Family chuẩn vào dự án Revit" Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#334155" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTotalFamilies" Text="0 Families Sẵn Có" Foreground="#38BDF8" FontWeight="Bold" FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. TOOLBAR (Search & Category Filter) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox x:Name="TxtSearch" Grid.Column="0" Height="32" VerticalContentAlignment="Center" 
                         Padding="8,0" Margin="0,0,10,0" FontSize="12"
                         TextChanged="TxtSearch_TextChanged"
                         ToolTip="Tìm kiếm tên Family..." />

                <!-- Category Combo -->
                <ComboBox x:Name="CboCategory" Grid.Column="1" Width="140" Height="32" 
                          VerticalContentAlignment="Center" Margin="0,0,10,0"
                          SelectionChanged="CboCategory_SelectionChanged" />

                <!-- Refresh Button -->
                <Button x:Name="BtnRefresh" Grid.Column="2" Content="Làm mới" Style="{StaticResource SecondaryButton}"
                        Click="BtnRefresh_Click" />
            </Grid>
        </Border>

        <!-- 3. DATA GRID -->
        <DataGrid x:Name="GridFamilies" Grid.Row="2" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                  SelectionMode="Extended" GridLinesVisibility="Horizontal"
                  MouseDoubleClick="GridFamilies_MouseDoubleClick"
                  HorizontalGridLinesBrush="#F1F5F9"
                  Background="White" BorderThickness="0" Margin="16,12,16,12"
                  RowHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên Family" Binding="{Binding Name}" Width="200" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Phân Loại" Binding="{Binding Category}" Width="100"/>
                <DataGridTemplateColumn Header="Trạng Thái Trong Dự Án" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadedInDocument}" Value="True">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Chưa nạp"/>
                                            <Setter Property="Foreground" Value="#991B1B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoadedInDocument}" Value="True">
                                                <Setter Property="Text" Value="Đã nạp"/>
                                                    <Setter Property="Foreground" Value="#166534"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Số Types" Binding="{Binding SymbolCount}" Width="80"/>
                <DataGridTextColumn Header="Dung Lượng" Binding="{Binding FormattedSize}" Width="90"/>
                <DataGridTextColumn Header="Đường Dẫn Đĩa" Binding="{Binding FullPath}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. BOTTOM ACTION BAR -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnBrowse" Content="Chọn file .rfa" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="BtnBrowse_Click"/>
                    <Button x:Name="BtnOpenFolder" Content="Mở thư mục" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="BtnOpenFolder_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnReload" Content="Nạp lại &amp; ghi đè" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="BtnReload_Click"/>
                    <Button x:Name="BtnLoad" Content="Nạp Family" Style="{StaticResource ModernButton}"
                            Margin="0,0,8,0" Click="BtnLoad_Click"/>
                    <Button x:Name="BtnClose" Content="Đóng" Style="{StaticResource SecondaryButton}" 
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
