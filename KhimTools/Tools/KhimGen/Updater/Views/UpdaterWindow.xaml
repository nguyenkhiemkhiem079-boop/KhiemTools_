<Window x:Class="KhimTools.Tools.Updater.Views.UpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KhimTools Update" 
        Height="470" Width="390"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2563EB" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <!-- Main Card with DropShadow -->
        <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
            </Border.Effect>

            <Grid Margin="20,18,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Version Box -->
                    <RowDefinition Height="Auto"/> <!-- Release Date -->
                    <RowDefinition Height="*"/>    <!-- Changelog -->
                    <RowDefinition Height="Auto"/> <!-- Status / Notice -->
                    <RowDefinition Height="Auto"/> <!-- Action Button -->
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo Badge -->
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="{StaticResource BrandGradient}">
                        <TextBlock Text="K" Foreground="White" FontSize="22" FontWeight="Bold" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    </Border>

                    <!-- Title & Notification -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="KhimTools" FontSize="17" FontWeight="Bold" Foreground="#1E293B" FontFamily="Segoe UI"/>
                        <TextBlock Text="Có phiên bản mới! 🔔" FontSize="13" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2" Click="BtnClose_Click" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="14">
                                    <TextBlock Text="✕" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- VERSION COMPARISON BOX -->
                <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16,12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                            <TextBlock Text="Hiện tại" FontSize="12" Foreground="#64748B" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtCurrentVersion" Text="v2.0.0" FontSize="20" FontWeight="Bold" Foreground="#334155" Margin="0,4,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="➔" FontSize="18" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,8,8,0"/>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="Phiên bản mới" FontSize="12" Foreground="#2563EB" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtLatestVersion" Text="v2.1.0" FontSize="20" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- RELEASE DATE -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="📅" FontSize="14" Margin="0,0,6,0"/>
                    <TextBlock Text="Ngày phát hành:" FontSize="13" Foreground="#64748B" FontWeight="Medium"/>
                    <TextBlock x:Name="TxtReleaseDate" Text=" 2026-08-20" FontSize="13" Foreground="#1E293B" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- CHANGELOG -->
                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="📋" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Có gì mới:" FontSize="13" Foreground="#1E293B" FontWeight="SemiBold"/>
                    </StackPanel>

                    <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListChangelog">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="✔" Foreground="#059669" FontSize="12" Margin="0,2,8,0" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12.5" Foreground="#334155" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- STATUS / NOTICE -->
                <Border Grid.Row="4" x:Name="PanelStatus" Margin="0,0,0,14" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10,8" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="☑" Foreground="#059669" FontSize="15" FontWeight="Bold" Margin="0,0,6,0"/>
                            <TextBlock Text="Cài đặt hoàn tất!" Foreground="#059669" FontSize="13.5" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="Khởi động lại Revit để áp dụng phiên bản mới." Foreground="#047857" FontSize="11.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- PROGRESS BAR -->
                <ProgressBar Grid.Row="4" x:Name="ProgressBarDownload" Height="6" Margin="0,0,0,14" Value="0" Maximum="100" Visibility="Collapsed" Foreground="#2563EB"/>

                <!-- ACTION BUTTON -->
                <Button Grid.Row="5" x:Name="BtnAction" Content="Cập nhật ngay" Style="{StaticResource PrimaryButton}" Height="38" Click="BtnAction_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
