<Page x:Class="KhimTools.Tools.Workspace.Views.KhimWorkspacePane"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="clr-namespace:KhimTools.Core.UI"
      Title="K-TOOLS Workspace" Background="#F5F7FA" FontFamily="Segoe UI">
    <Page.Resources>
        <Style x:Key="LauncherButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE2E8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EAF3FD"/><Setter TargetName="Surface" Property="BorderBrush" Value="#1677D2"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EAF3FD"/><Setter TargetName="Surface" Property="BorderBrush" Value="#1677D2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D7E9FB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolName" TargetType="TextBlock"><Setter Property="Foreground" Value="#20262E"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
        <Style x:Key="ModuleLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#6B7785"/><Setter Property="FontSize" Value="9"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
    </Page.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions>
            <TextBox x:Name="ToolSearch" Grid.Row="0" Padding="28,3,8,3" TextChanged="Filter_Changed" ToolTip="Tìm tất cả công cụ"/>
            <Image Width="16" Height="16" HorizontalAlignment="Left" Margin="8,0,0,0" Source="{ui:UiIcon icon_search_16.png}" IsHitTestVisible="False"/>
            <TextBlock Grid.Row="0" Text="Tìm công cụ..." Foreground="#8995A3" Margin="29,0,5,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ToolSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <ComboBox x:Name="ModuleFilter" Grid.Row="1" Margin="0,5,0,0" SelectionChanged="Filter_Changed" SelectedIndex="0">
                <ComboBoxItem Content="Tất cả" Tag="All"/><ComboBoxItem Content="Rebar" Tag="Rebar"/><ComboBoxItem Content="Model" Tag="Model"/><ComboBoxItem Content="Docs" Tag="Docs"/><ComboBoxItem Content="MEP" Tag="MEP"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ToolList">
                <Button Style="{StaticResource LauncherButton}" Tag="Model|family library load tải nạp thư viện rebar shape" Command="{Binding RunFamilyManagerCommand}" ToolTip="Family Library" AutomationProperties.Name="Family Library"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon icon_family_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="Family Library"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="MODEL"/></Grid></Button>
                <Button Style="{StaticResource LauncherButton}" Tag="Rebar|column rebar cột thép" Command="{Binding RunColumnRebarCommand}" ToolTip="Column Rebar" AutomationProperties.Name="Column Rebar"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon column_rebar_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="Column Rebar"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="REBAR"/></Grid></Button>
                <Button Style="{StaticResource LauncherButton}" Tag="Rebar|beam rebar dầm thép" Command="{Binding RunBeamRebarCommand}" ToolTip="Beam Rebar" AutomationProperties.Name="Beam Rebar"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon rebar_beam_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="Beam Rebar"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="REBAR"/></Grid></Button>
                <Button Style="{StaticResource LauncherButton}" Tag="Rebar|slab rebar sàn thép" Command="{Binding RunSlabRebarCommand}" ToolTip="Slab Rebar" AutomationProperties.Name="Slab Rebar"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon rebar_slab_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="Slab Rebar"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="REBAR"/></Grid></Button>
                <Button Style="{StaticResource LauncherButton}" Tag="Rebar|foundation rebar móng thép chờ" Command="{Binding RunFoundationRebarCommand}" ToolTip="Foundation Rebar" AutomationProperties.Name="Foundation Rebar"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon rebar_fdn_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="Foundation Rebar"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="REBAR"/></Grid></Button>
                <Button Style="{StaticResource LauncherButton}" Tag="Rebar|section cut mặt cắt" Command="{Binding RunSectionCutCommand}" ToolTip="Smart Section Cut" AutomationProperties.Name="Smart Section Cut"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon icon_section_cut_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="Smart Section Cut"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="REBAR"/></Grid></Button>

                <Button Style="{StaticResource LauncherButton}" Tag="Model|join unjoin geometry hình học" Command="{Binding RunJoinElementsCommand}" ToolTip="Join Elements" AutomationProperties.Name="Join Elements"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon icon_join_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="Join Elements"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="MODEL"/></Grid></Button>
                <Button Style="{StaticResource LauncherButton}" Tag="Model|grid floor plan lưới tầng" Command="{Binding RunGridPlanGeneratorCommand}" ToolTip="Grid &amp; Floor Plan" AutomationProperties.Name="Grid &amp; Floor Plan"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon icon_grid_plan_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="Grid &amp; Floor Plan"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="MODEL"/></Grid></Button>
                <Button Style="{StaticResource LauncherButton}" Tag="Model|copy link elements liên kết" Command="{Binding RunCopyFromLinkCommand}" ToolTip="Copy Link Elements" AutomationProperties.Name="Copy Link Elements"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon icon_copylink_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="Copy Link Elements"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="MODEL"/></Grid></Button>
                <Button Style="{StaticResource LauncherButton}" Tag="Model|room 3d view phòng" Command="{Binding RunRoom3DViewCommand}" ToolTip="Room 3D View" AutomationProperties.Name="Room 3D View"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon icon_room3d_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="Room 3D View"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="MODEL"/></Grid></Button>
                <Button Style="{StaticResource LauncherButton}" Tag="Model|room finishes hoàn thiện phòng" Command="{Binding RunWallFloorFinishesCommand}" ToolTip="Room Finishes" AutomationProperties.Name="Room Finishes"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon icon_finishes_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="Room Finishes"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="MODEL"/></Grid></Button>

                <Button Style="{StaticResource LauncherButton}" Tag="Docs|align viewport căn chỉnh" Command="{Binding RunAlignViewportCommand}" ToolTip="Align Viewports" AutomationProperties.Name="Align Viewports"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon icon_align_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="Align Viewports"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="DOCS"/></Grid></Button>
                <Button Style="{StaticResource LauncherButton}" Tag="Docs|detail number số chi tiết" Command="{Binding RunUpdateDetailNoCommand}" ToolTip="Update Detail Numbers" AutomationProperties.Name="Update Detail Numbers"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon icon_detail_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="Update Detail Numbers"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="DOCS"/></Grid></Button>
                <Button Style="{StaticResource LauncherButton}" Tag="Docs|sheet export pdf dwg xuất bản" Command="{Binding RunSheetExportCommand}" ToolTip="Sheet Exporter" AutomationProperties.Name="Sheet Exporter"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon export_sheet_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="Sheet Exporter"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="DOCS"/></Grid></Button>

                <Button Style="{StaticResource LauncherButton}" Tag="MEP|openings lỗ mở penetration" Command="{Binding RunMepOpeningsCommand}" ToolTip="MEP Openings" AutomationProperties.Name="MEP Openings"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon icon_mep_openings_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="MEP Openings"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="MEP"/></Grid></Button>
                <Button Style="{StaticResource LauncherButton}" Tag="MEP|elevation tags cao độ" Command="{Binding RunMepElevationTagsCommand}" ToolTip="MEP Elevation Tags" AutomationProperties.Name="MEP Elevation Tags"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{ui:UiIcon icon_mep_tags_32.png}"/><TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource ToolName}" Text="MEP Elevation Tags"/><TextBlock Grid.Column="2" Style="{StaticResource ModuleLabel}" Text="MEP"/></Grid></Button>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="EmptyState" Text="Không tìm thấy công cụ." Foreground="#526170" TextWrapping="Wrap" Margin="8,16" Visibility="Collapsed"/>
        </Grid>

        <Grid Grid.Row="2" Margin="2,7,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#647181" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Command="{Binding CheckUpdateCommand}" Width="30" Height="30" Padding="5" Margin="6,0,0,0" ToolTip="Kiểm tra cập nhật" AutomationProperties.Name="Kiểm tra cập nhật"><Image Width="16" Height="16" Source="{ui:UiIcon icon_update_16.png}"/></Button>
        </Grid>
    </Grid>
</Page>
