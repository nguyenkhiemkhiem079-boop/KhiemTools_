<Window x:Class="KhimTools.SectionBox.Forms.SectionBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Section Box Pro" 
        Height="360" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Roboto"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#FFFFFF" BorderBrush="#E0F2FE" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="270" RenderingBias="Quality" ShadowDepth="3" Color="#94A3B8" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#F0F9FF" CornerRadius="14,14,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="K-TOOLS — Section Box Pro" 
                               FontWeight="Bold" FontSize="14" 
                               Foreground="#0284C7" 
                               VerticalAlignment="Center" HorizontalAlignment="Left" 
                               Margin="16,0,0,0"/>
                    <Button Content="✕" 
                            Click="BtnClose_Click" 
                            HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Margin="0,0,16,0" 
                            Width="24" Height="24" 
                            Background="Transparent" BorderBrush="Transparent" 
                            Foreground="#64748B" FontWeight="Bold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Selection Mode RadioButtons -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Center">
                    <RadioButton x:Name="RadioLevel" Content="Theo Level" IsChecked="True" 
                                 Checked="Radio_ModeChanged" GroupName="Mode" 
                                 FontWeight="SemiBold" Margin="0,0,32,0"/>
                    <RadioButton x:Name="RadioSelection" Content="Theo Cấu kiện chọn" 
                                 Checked="Radio_ModeChanged" GroupName="Mode" 
                                 FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Mode 1: Level Fields -->
                <Grid x:Name="PanelLevel" Grid.Row="1" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Chọn Level" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ComboLevels" Height="28" BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Offset Trên (mm)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtTopOffset" Text="500" Height="28" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Padding="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Offset Dưới (mm)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtBottomOffset" Text="-500" Height="28" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Padding="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Mode 2: Selection Fields -->
                <Grid x:Name="PanelSelection" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" Margin="0,8,0,8">
                        <TextBlock x:Name="TxtSelectionStatus" Text="Chưa chọn đối tượng nào" 
                                   HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#475569"/>
                        <Button x:Name="BtnPickElements" Content="Quét chọn cấu kiện trong Revit" 
                                Click="BtnPickElements_Click" Margin="0,12,0,0" Height="30" Width="200"
                                Background="#F1F5F9" BorderBrush="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <!-- View Configuration (Bottom area of content) -->
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="View Template 3D" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <ComboBox x:Name="ComboTemplates" Height="28" BorderBrush="#CBD5E1"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tên Hậu Tố View" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtViewNameSuffix" Text="" Height="28" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Padding="4,0,0,0">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Resources>
                                            <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Ví dụ: KhuA" Foreground="#94A3B8" FontSize="12" Margin="4,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Style.Resources>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter Property="Background" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Bottom Actions -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,14,14" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid>
                    <Button x:Name="BtnCreate" Content="TẠO SECTION BOX" 
                            Click="BtnCreate_Click"
                            Width="200" Height="36" 
                            Background="#0284C7" BorderBrush="#0284C7" 
                            Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="18" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0369A1"/>
                                        <Setter Property="BorderBrush" Value="#0369A1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
