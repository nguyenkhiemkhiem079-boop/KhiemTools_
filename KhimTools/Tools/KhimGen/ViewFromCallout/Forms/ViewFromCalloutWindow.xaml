<Window x:Class="KhimTools.ViewFromCallout.Forms.ViewFromCalloutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo View từ Callout" 
        Height="400" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Roboto"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#FFFFFF" BorderBrush="#E0F2FE" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="270" RenderingBias="Quality" ShadowDepth="3" Color="#94A3B8" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#F0F9FF" CornerRadius="14,14,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="K-TOOLS — Tạo View từ Callout" 
                               FontWeight="Bold" FontSize="14" 
                               Foreground="#0284C7" 
                               VerticalAlignment="Center" HorizontalAlignment="Left" 
                               Margin="16,0,0,0"/>
                    <Button Content="✕" 
                            Click="BtnClose_Click" 
                            HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Margin="0,0,16,0" 
                            Width="24" Height="24" 
                            Background="Transparent" BorderBrush="Transparent" 
                            Foreground="#64748B" FontWeight="Bold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Target Callout Info -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10,12,10" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Chọn Callout gốc (Detail/Section View)" FontSize="11" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ComboCallouts" Height="28" BorderBrush="#CBD5E1"/>
                    </StackPanel>
                </Border>

                <!-- Generation Options Grid -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: Floor Plan Creator -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChkPlan" Content="Mặt bằng (Plan)" IsChecked="True" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ComboPlanTemplates" Grid.Column="1" Height="28" BorderBrush="#CBD5E1" IsEnabled="{Binding IsChecked, ElementName=ChkPlan}"/>
                    </Grid>

                    <!-- Row 2: Elevation Creator -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ChkElevation" Content="Mặt đứng (Elev)" IsChecked="True" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ComboElevTemplates" Grid.Column="1" Height="28" BorderBrush="#CBD5E1" IsEnabled="{Binding IsChecked, ElementName=ChkElevation}"/>
                    </Grid>

                    <!-- Row 3: 3D Creator -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="Chk3D" Content="Khung nhìn 3D" IsChecked="True" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox x:Name="Combo3DTemplates" Grid.Column="1" Height="28" BorderBrush="#CBD5E1" IsEnabled="{Binding IsChecked, ElementName=Chk3D}"/>
                    </Grid>

                    <!-- Row 4: Suffix/Prefix Name Config -->
                    <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="Mẫu tên (Naming Suffix)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtNameSuffix" Text="" Height="28" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Padding="4,0,0,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Resources>
                                        <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Ví dụ: - Detail" Foreground="#94A3B8" FontSize="12" Margin="4,0,0,0"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Background" Value="{StaticResource CueBannerBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Bottom Actions -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,14,14" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid>
                    <Button x:Name="BtnCreate" Content="TẠO CÁC VIEW MỚI" 
                            Click="BtnCreate_Click"
                            Width="200" Height="36" 
                            Background="#0284C7" BorderBrush="#0284C7" 
                            Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="18" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0369A1"/>
                                        <Setter Property="BorderBrush" Value="#0369A1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
