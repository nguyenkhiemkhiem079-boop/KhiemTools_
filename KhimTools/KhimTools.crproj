<?xml version="1.0" encoding="utf-8" ?>
<!--
  ConfuserEx Configuration — K-TOOLS Revit Plugin
  ================================================
  Mức bảo vệ: TRUNG BÌNH
    - Rename:         Đổi tên class/method/field thành ký tự vô nghĩa
    - Control Flow:   Làm rối luồng code (chống decompile logic)
    - Constants:      Mã hóa string literals trong code
    - Anti-Tamper:    Từ chối chạy nếu DLL bị sửa đổi

  QUAN TRỌNG — Revit Exclusions:
    Các class implement IExternalApplication/IExternalCommand
    KHÔNG được đổi tên vì Revit load bằng reflection theo full class name.

  Cách dùng (qua Obfuscate.ps1 — thay {INPUT_DIR} và {OUTPUT_DIR} tự động):
    Confuser.CLI.exe KhimTools.crproj
-->
<project outputDir="{OUTPUT_DIR}"
         baseDir="{INPUT_DIR}"
         xmlns="http://confuser.codeplex.com">

  <module path="KhimTools.dll">

    <!-- ================================================================
         RULE MẶC ĐỊNH: Áp dụng bảo vệ cho toàn bộ assembly
    ================================================================ -->
    <rule pattern="true" inherit="true">

      <!-- Rename: đổi tên class, method, field thành ký tự unicode vô nghĩa -->
      <protection id="rename">
        <argument name="mode" value="unicode" />
      </protection>

      <!-- Control Flow: làm rối if/else/switch/loop, chống decompile logic -->
      <protection id="ctrl flow">
        <argument name="intensity" value="5" />
      </protection>

      <!-- Constants/String Encryption: mã hóa string literals -->
      <protection id="constants">
        <argument name="mode" value="dynamic" />
      </protection>

      <!-- Anti-Tamper: từ chối chạy nếu DLL bị patch/sửa đổi -->
      <protection id="anti tamper">
        <argument name="mode" value="jit" />
      </protection>

    </rule>

    <!-- ================================================================
         EXCLUSIONS — Revit Entry Points (KHÔNG được đổi tên)
         Revit dùng reflection để tìm class theo full name trong .addin.
         Nếu bị rename → Revit không load được plugin → crash khi khởi động.
    ================================================================ -->

    <!-- IExternalApplication — entry point chính khai báo trong .addin -->
    <rule pattern="type('KhimTools.Core.App')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>

    <!-- KhimCmdProxy — abstract base dùng Activator.CreateInstance (reflection) -->
    <rule pattern="type('KhimTools.Core.KhimCmdProxy')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>

    <!-- ── RebarTool Commands ──────────────────────────────────────── -->
    <rule pattern="type('KhimTools.RebarTool.Commands.CmdColumnRebar')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>
    <rule pattern="type('KhimTools.RebarTool.Commands.CmdColumnRebarV2')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>
    <rule pattern="type('KhimTools.RebarTool.Commands.CmdMultiColumnRebar')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>
    <rule pattern="type('KhimTools.RebarTool.Commands.CmdMultiRoundColumnRebar')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>
    <rule pattern="type('KhimTools.RebarTool.Commands.CmdBeamRebar')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>
    <rule pattern="type('KhimTools.RebarTool.Commands.CmdSlabRebar')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>
    <rule pattern="type('KhimTools.RebarTool.Commands.CmdFoundationRebar')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>
    <rule pattern="type('KhimTools.RebarTool.Commands.CmdColumnDrawing')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>
    <rule pattern="type('KhimTools.RebarTool.Commands.CmdUpdateColumnDrawing')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>
    <rule pattern="type('KhimTools.RebarTool.Commands.CmdProjectCoverSetup')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>

    <!-- ── SlabJoin Commands ──────────────────────────────────────── -->
    <rule pattern="type('KhimTools.SlabJoin.Commands.CmdJoinElements')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>
    <rule pattern="type('KhimTools.SlabJoin.Commands.JoinSlabsCommand')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>
    <rule pattern="type('KhimTools.SlabJoin.Commands.UnjoinSlabsCommand')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>

    <!-- ── SheetExport Commands ───────────────────────────────────── -->
    <rule pattern="type('KhimTools.SheetExport.Commands.CmdSheetExport')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>

    <!-- ── ViewportAlign Commands ─────────────────────────────────── -->
    <rule pattern="type('KhimTools.ViewportAlign.Commands.CmdAlignViewport')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>

    <!-- ── SectionCutTool Commands ────────────────────────────────── -->
    <rule pattern="type('KhimTools.SectionCutTool.Commands.CmdSectionCut')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>

    <!-- ── DetailNumberUpdater Commands ──────────────────────────── -->
    <rule pattern="type('KhimTools.DetailNumberUpdater.Commands.CmdUpdateDetailNumbers')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>

    <!-- Safety net: bắt tất cả IExternalCommand/IExternalApplication còn lại -->
    <rule pattern="implements('Autodesk.Revit.UI.IExternalCommand')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>
    <rule pattern="implements('Autodesk.Revit.UI.IExternalApplication')" inherit="false">
      <protection id="rename" action="remove" />
    </rule>

  </module>

</project>
