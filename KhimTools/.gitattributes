# Auto detect text files and perform LF normalization
* text=auto

# Source code files
*.cs text eol=crlf
*.xaml text eol=crlf
*.xml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.json text eol=crlf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.txt text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.dll binary
*.exe binary
*.zip binary
