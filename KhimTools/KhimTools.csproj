<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48  -> Revit 2022-2024 (.NET Framework)
         net8.0-windows -> Revit 2025-2026 (.NET 8) -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>KhimTools</RootNamespace>
    <AssemblyName>KhimTools</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- ==== Đường dẫn RevitAPI theo từng TFM ====
       net48 build tự tìm Revit 2024/2023/2022 trên máy, hoặc fallback sang 2023.
       net8.0-windows nếu có Revit 2025/2026 local thì dùng, không thì tự nạp từ NuGet Nice3point.Revit.Api -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net48'">
    <RevitVersionForReference Condition="'$(RevitVersionForReference)'=='' and Exists('C:\Program Files\Autodesk\Revit 2024\RevitAPI.dll')">2024</RevitVersionForReference>
    <RevitVersionForReference Condition="'$(RevitVersionForReference)'=='' and Exists('C:\Program Files\Autodesk\Revit 2023\RevitAPI.dll')">2023</RevitVersionForReference>
    <RevitVersionForReference Condition="'$(RevitVersionForReference)'=='' and Exists('C:\Program Files\Autodesk\Revit 2022\RevitAPI.dll')">2022</RevitVersionForReference>
    <RevitVersionForReference Condition="'$(RevitVersionForReference)'==''">2023</RevitVersionForReference>
    <VersionFolder>Legacy</VersionFolder>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <RevitVersionForReference Condition="'$(RevitVersionForReference)'=='' and Exists('C:\Program Files\Autodesk\Revit 2026\RevitAPI.dll')">2026</RevitVersionForReference>
    <RevitVersionForReference Condition="'$(RevitVersionForReference)'=='' and Exists('C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll')">2025</RevitVersionForReference>
    <RevitVersionForReference Condition="'$(RevitVersionForReference)'==''">2025</RevitVersionForReference>
    <VersionFolder>Modern</VersionFolder>
  </PropertyGroup>

  <!-- Dùng reference local nếu có file DLL trên máy -->
  <ItemGroup Condition="Exists('C:\Program Files\Autodesk\Revit $(RevitVersionForReference)\RevitAPI.dll')">
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersionForReference)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersionForReference)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Fallback sang NuGet package Nice3point cho net8.0-windows nếu máy chưa cài Revit 2025/2026 -->
  <ItemGroup Condition="'$(TargetFramework)'=='net8.0-windows' and !Exists('C:\Program Files\Autodesk\Revit $(RevitVersionForReference)\RevitAPI.dll')">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Loại trừ App (standalone updater exe) khỏi KhimTools Revit plugin dll -->
  <ItemGroup>
    <Compile Remove="App\**" />
    <Page Remove="App\**" />
    <None Remove="App\**" />
    <ApplicationDefinition Remove="App\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="PdfSharp" Version="6.1.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\*.png" />
  </ItemGroup>

  <!-- Rebar Shape families (toàn bộ bộ JP_T##) — copy vào RebarShapes\ subfolder trong output
       để RebarShapeLibrary.ResolveRfaPath() tìm đúng đường dẫn lúc runtime trong Revit. -->
  <ItemGroup>
    <None Include="Tools\RebarTool\RebarShapes\*.rfa">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>RebarShapes\%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <!-- ==== Post-build: đóng gói .bundle và copy vào ApplicationPlugins (auto-load, không cần copy tay) ====
       CẦN VERIFY: PackageContents.xml schema đã viết theo cấu trúc bundle phổ biến của Autodesk
       nhưng chưa test thật; nếu Revit không nhận bundle, kiểm tra lại theo tài liệu Autodesk
       "Add-In Manager / ApplicationPlugins bundle format" mới nhất. -->
  <Target Name="DeployKhimToolsBundle" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <PropertyGroup>
      <BundleRoot>$(ProgramData)\Autodesk\ApplicationPlugins\KhimTools.bundle</BundleRoot>
      <VersionFolder Condition="'$(TargetFramework)'=='net48'">Legacy</VersionFolder>
      <VersionFolder Condition="'$(TargetFramework)'=='net8.0-windows'">Modern</VersionFolder>
      <BundleVersionDir>$(BundleRoot)\Contents\$(VersionFolder)</BundleVersionDir>
    </PropertyGroup>

    <!-- Copy FLAT (không dùng %(RecursiveDir)) — Revit tìm KhimTools.dll cùng cấp với .addin -->
    <ItemGroup>
      <BundleDlls Include="$(OutDir)*.dll" />
      <!-- .rfa được copy vào $(OutDir)RebarShapes\ nhờ TargetPath trong ItemGroup bên trên -->
      <BundleRfas Include="$(OutDir)RebarShapes\*.rfa" />
      <AddinManifest Include="Deploy\$(VersionFolder)\KhimTools.addin" />
      <PackageManifest Include="Deploy\PackageContents.xml" />
    </ItemGroup>

    <MakeDir Directories="$(BundleVersionDir)" />

    <!-- Copy tất cả DLL phẳng vào thư mục version (tăng retry, báo lỗi rõ nếu Revit đang khóa file) -->
    <Copy SourceFiles="@(BundleDlls)"
          DestinationFolder="$(BundleVersionDir)"
          SkipUnchangedFiles="true"
          Retries="5"
          RetryDelayMilliseconds="1000"
          ContinueOnError="WarnAndContinue">
      <Output TaskParameter="CopiedFiles" ItemName="SuccessfullyCopiedDlls" />
    </Copy>
    <Error Condition="'$(MSBuildLastTaskResult)' == 'false'" Text="[K-TOOLS DEPLOY LỖI] KhimTools.dll đang bị khóa bởi Revit — hãy đóng Revit trước khi build lại!" />

    <!-- Copy .rfa shape families vào subfolder RebarShapes (khớp với RebarShapeLibrary.FolderName) -->
    <MakeDir Directories="$(BundleVersionDir)\RebarShapes" />
    <Copy SourceFiles="@(BundleRfas)"
          DestinationFolder="$(BundleVersionDir)\RebarShapes"
          SkipUnchangedFiles="true"
          Retries="5"
          RetryDelayMilliseconds="1000"
          ContinueOnError="WarnAndContinue" />

    <!-- Copy .addin manifest và PackageContents.xml -->
    <Copy SourceFiles="@(AddinManifest)" DestinationFolder="$(BundleVersionDir)" SkipUnchangedFiles="true" Retries="3" RetryDelayMilliseconds="500" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="@(PackageManifest)" DestinationFolder="$(BundleRoot)" SkipUnchangedFiles="true" Retries="3" RetryDelayMilliseconds="500" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
