<Window x:Class="KhiemToolsApp.AppUpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="K-TOOLS Updater" Height="480" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Blue Theme Gradient for Brand Logo -->
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#38BDF8" Offset="0"/>
            <GradientStop Color="#0284C7" Offset="1"/>
        </LinearGradientBrush>

        <!-- Modern Border/Card Style with Shadow -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#0F172A" Opacity="0.03"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom iOS Style Toggle Switch -->
        <Style x:Key="iOSToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="38" Height="20">
                            <Border x:Name="BackgroundBorder" Background="#CBD5E1" CornerRadius="10"/>
                            <Border x:Name="ThumbBorder" HorizontalAlignment="Left" Width="16" Height="16" 
                                    CornerRadius="8" Background="White" Margin="2,0,0,0" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="Black" Opacity="0.15"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#0284C7"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" 
                                                             Storyboard.TargetProperty="X" 
                                                             To="18" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" 
                                                             Storyboard.TargetProperty="X" 
                                                             To="0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Header -->
            <RowDefinition Height="Auto"/> <!-- 1. Version Cards -->
            <RowDefinition Height="Auto"/> <!-- 2. Actions -->
            <RowDefinition Height="Auto"/> <!-- 3. Settings Title -->
            <RowDefinition Height="*"/>    <!-- 4. Settings List -->
            <RowDefinition Height="Auto"/> <!-- 5. Uninstall -->
            <RowDefinition Height="Auto"/> <!-- 6. Footer -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER (TITLE & BADGE) -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="K-TOOLS" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Quản lý cập nhật tự động" FontSize="13.5" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Logo 3D Badge -->
            <Border Grid.Column="1" Width="52" Height="52" CornerRadius="12" Background="{StaticResource BrandGradient}">
                <TextBlock Text="K" FontSize="28" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- 2. VERSION CARDS (HIỆN TẠI vs GITHUB) -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Thẻ phiên bản hiện tại -->
            <Border Grid.Column="0" Background="#F0F9FF" BorderBrush="#E0F2FE" BorderThickness="1" CornerRadius="14" Padding="14,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Color="#0284C7" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TxtLocalVersion" Text="Đang kiểm tra..." FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Phiên bản hiện tại" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Thẻ phiên bản trên GitHub -->
            <Border Grid.Column="2" Background="#F0F9FF" BorderBrush="#E0F2FE" BorderThickness="1" CornerRadius="14" Padding="14,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Color="#0284C7" Opacity="0.05"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TxtGithubVersion" Text="—" FontSize="20" FontWeight="Bold" Foreground="#0284C7"/>
                    <TextBlock Text="Trên GitHub" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. ACTION BUTTONS -->
        <StackPanel Grid.Row="2" Margin="0,0,0,24">
            <!-- Nút kiểm tra cập nhật -->
            <Button x:Name="BtnCheckUpdate" Height="42" Background="#0284C7" Foreground="White" 
                    FontWeight="SemiBold" FontSize="14" Cursor="Hand" Margin="0,0,0,10" Click="BtnCheckUpdate_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Color="#0284C7" Opacity="0.15"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔄 " FontSize="14"/>
                                <TextBlock Text="Kiểm tra cập nhật ngay"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Nút Góp ý / Báo lỗi -->
            <Button Height="38" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" 
                    Foreground="#334155" FontWeight="SemiBold" FontSize="13.5" Cursor="Hand" Click="BtnFeedback_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="💬 " FontSize="13"/>
                                <TextBlock Text="Góp ý / Báo lỗi"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- 4. TIÊU ĐỀ CÀI ĐẶT -->
        <TextBlock Grid.Row="3" Text="CÀI ĐẶT" FontSize="11.5" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,8"/>

        <!-- 5. DANH SÁCH CHECKBOX CÀI ĐẶT -->
        <StackPanel Grid.Row="4">
            <!-- Tự khởi động cùng Windows -->
            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tự khởi động cùng Windows" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="Chạy ngầm khi mở máy để check update" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="ChkAutoStart" Style="{StaticResource iOSToggle}" VerticalAlignment="Center" IsChecked="True" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                </Grid>
            </Border>

            <!-- Thông báo popup -->
            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Thông báo popup" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="Hiện popup khi có phiên bản mới" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="ChkShowPopup" Style="{StaticResource iOSToggle}" VerticalAlignment="Center" IsChecked="True"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 6. NÚT GỠ CÀI ĐẶT -->
        <Button Grid.Row="5" Height="38" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" 
                Foreground="#DC2626" FontWeight="SemiBold" FontSize="13" Cursor="Hand" Margin="0,10,0,10" Click="BtnUninstall_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🗑 " FontSize="13"/>
                            <TextBlock Text="Gỡ cài đặt K-TOOLS"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="#FEE2E2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- 7. FOOTER VERSION -->
        <TextBlock x:Name="TxtUpdaterVersion" Grid.Row="6" Text="K-TOOLS Updater" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
    </Grid>
</Window>
