<Window x:Class="KhiemToolsApp.AppUpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KhiemTools Updater" 
        Height="620" Width="430"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2563EB" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="1"/>
        </LinearGradientBrush>

        <!-- Style Card Cài đặt -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Version Cards -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            <RowDefinition Height="Auto"/> <!-- Settings Title -->
            <RowDefinition Height="*"/>    <!-- Settings Items -->
            <RowDefinition Height="Auto"/> <!-- Uninstall Button -->
            <RowDefinition Height="Auto"/> <!-- Footer Version -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="KhiemTools" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Quản lý cập nhật tự động" FontSize="13.5" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Logo 3D Badge -->
            <Border Grid.Column="1" Width="52" Height="52" CornerRadius="12" Background="{StaticResource BrandGradient}">
                <TextBlock Text="K" FontSize="28" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- 2. VERSION CARDS (HIỆN TẠI vs GITHUB) -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Thẻ phiên bản hiện tại -->
            <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="10" Padding="14,12">
                <StackPanel>
                    <TextBlock x:Name="TxtLocalVersion" Text="2.1.0" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Phiên bản hiện tại" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Thẻ phiên bản trên GitHub -->
            <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="10" Padding="14,12">
                <StackPanel>
                    <TextBlock x:Name="TxtGithubVersion" Text="—" FontSize="22" FontWeight="Bold" Foreground="#2563EB"/>
                    <TextBlock Text="Trên GitHub" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. ACTION BUTTONS -->
        <StackPanel Grid.Row="2" Margin="0,0,0,24">
            <!-- Nút kiểm tra cập nhật -->
            <Button x:Name="BtnCheckUpdate" Height="42" Background="#2563EB" Foreground="White" 
                    FontWeight="SemiBold" FontSize="14" Cursor="Hand" Margin="0,0,0,10" Click="BtnCheckUpdate_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔄 " FontSize="14"/>
                                <TextBlock Text="Kiểm tra cập nhật ngay"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Nút Góp ý / Báo lỗi -->
            <Button Height="38" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" 
                    Foreground="#334155" FontWeight="SemiBold" FontSize="13.5" Cursor="Hand" Click="BtnFeedback_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="💬 " FontSize="13"/>
                                <TextBlock Text="Góp ý / Báo lỗi"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- 4. TIÊU ĐỀ CÀI ĐẶT -->
        <TextBlock Grid.Row="3" Text="CÀI ĐẶT" FontSize="11.5" FontWeight="Bold" Foreground="#64748B" Margin="2,0,0,8"/>

        <!-- 5. DANH SÁCH CHECKBOX CÀI ĐẶT -->
        <StackPanel Grid.Row="4">
            <!-- Tự khởi động cùng Windows -->
            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tự khởi động cùng Windows" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="Chạy ngầm khi mở máy để check update" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="ChkAutoStart" VerticalAlignment="Center" IsChecked="True" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                </Grid>
            </Border>

            <!-- Thông báo popup -->
            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Thông báo popup" FontSize="13.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="Hiện popup khi có phiên bản mới" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="ChkShowPopup" VerticalAlignment="Center" IsChecked="True"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 6. NÚT GỠ CÀI ĐẶT -->
        <Button Grid.Row="5" Height="38" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" 
                Foreground="#DC2626" FontWeight="SemiBold" FontSize="13" Cursor="Hand" Margin="0,10,0,10" Click="BtnUninstall_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🗑 " FontSize="13"/>
                            <TextBlock Text="Gỡ cài đặt KhiemTools"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="#FEE2E2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- 7. FOOTER VERSION -->
        <TextBlock Grid.Row="6" Text="v1.0.3" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
    </Grid>
</Window>
