<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RevitVersionForReference Condition="'$(RevitVersionForReference)'==''">2025</RevitVersionForReference>
    <RevitRequestedVersion Condition="'$(RevitRequestedVersion)'==''">$(RevitVersionForReference)</RevitRequestedVersion>
    <Version>1.0.0</Version>
    <AssemblyName>KhimTools.RevitSmoke</AssemblyName>
    <RootNamespace>KhimTools.Diagnostics.RevitSmoke</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup Condition="Exists('C:\Program Files\Autodesk\Revit $(RevitVersionForReference)\RevitAPI.dll')">
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersionForReference)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersionForReference)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net8.0-windows' and !Exists('C:\Program Files\Autodesk\Revit $(RevitVersionForReference)\RevitAPI.dll')">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.0.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.0.2" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="ValidateRevitApiReference" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RevitRequestedVersion)' != '$(RevitVersionForReference)'" Text="Revit API reference mismatch: requested $(RevitRequestedVersion), resolved $(RevitVersionForReference)." />
    <Error Condition="'$(RevitVersionForReference)' != '2025'" Text="The runtime smoke assembly currently targets Revit 2025 only." />
  </Target>
</Project>
