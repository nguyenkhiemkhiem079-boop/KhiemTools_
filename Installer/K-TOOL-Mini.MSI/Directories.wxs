<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DIR_Autodesk" Name="Autodesk">
        <Directory Id="DIR_ApplicationPlugins" Name="ApplicationPlugins">
          <Directory Id="BUNDLEFOLDER" Name="KhimTools.Mini.bundle">
            <Directory Id="CONTENTSFOLDER" Name="Contents">
              
              <!-- Legacy Revit 2022-2024 (.NET Framework 4.8) -->
              <Directory Id="LEGACYFOLDER" Name="Legacy" />

              <!-- Modern Revit 2025-2026 (.NET 8.0) -->
              <Directory Id="MODERNFOLDER" Name="Modern" />

            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
  </Fragment>
</Wix>
