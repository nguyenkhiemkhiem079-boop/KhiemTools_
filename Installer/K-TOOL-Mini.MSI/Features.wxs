<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <Feature Id="Complete" Title="K-TOOL Mini" Description="Standalone Element Tags and Copy Link Elements for Autodesk Revit" Level="1" ConfigurableDirectory="BUNDLEFOLDER">

      <!-- Mandatory Core Feature -->
      <Feature Id="CoreTools" Title="Core Runtime" Description="Revit bundle manifest and registry integration" Level="1" AllowAbsent="no">
        <ComponentRef Id="C_PackageContentsXml" />
        <ComponentRef Id="C_RegistryOwnership" />
      </Feature>

      <!-- Revit 2022-2024 (.NET Framework 4.8) -->
      <Feature Id="RevitLegacy" Title="K-TOOL Mini for Revit 2022-2024 (.NET 4.8)" Description="Binaries for Autodesk Revit 2022 through 2024" Level="1">
        <Level Value="1" Condition="HAS_LEGACY_REVIT = 1" />
        <ComponentRef Id="C_LegacyAddin" />
        <ComponentRef Id="C_LegacyDlls" />
      </Feature>

      <!-- Revit 2025-2026 (.NET 8.0) -->
      <Feature Id="RevitModern" Title="K-TOOL Mini for Revit 2025-2026 (.NET 8.0)" Description="Binaries for Autodesk Revit 2025 through 2026" Level="1">
        <Level Value="1" Condition="HAS_MODERN_REVIT = 1" />
        <ComponentRef Id="C_ModernAddin" />
        <ComponentRef Id="C_ModernDlls" />
      </Feature>

    </Feature>
  </Fragment>
</Wix>
